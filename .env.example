# Copy to .env on the head node, fill in your topology, then copy the same
# file to the worker. Do not commit .env or any generated API-key file.

HEAD_HOST=head
WORKER_HOST=worker
REMOTE_INSTALL_DIR=/opt/dsv4-vision-dgx-spark

# Exact local checkpoint path; use the same path on both nodes.
MODEL_DIR=/srv/models/deepseek-ai-DeepSeek-V4-Flash-Vision-Exp-86f746b3
MODEL_REVISION=86f746b36186f0e567729a5c06a8c918caba82a9

# Direct RoCE topology. Replace these example addresses and interface names.
HEAD_ADDR=203.0.113.10
DIST_PORT=20000
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=rocep1s0f1
NCCL_IB_GID_INDEX=3

API_PORT=8198
CONTEXT_LENGTH=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
KV_CACHE_DTYPE=nvfp4_ds_mla

# Draft depth for DSpark speculative decoding. This checkpoint's
# num_nextn_predict_layers=3 requires k >= 5 and divisible by 3; 6 is the
# only value in the recipe's tested range that satisfies both. Values of 3
# and 5 are rejected at container-entrypoint validation, before serving.
MTP_NUM_TOKENS=6

VLLM_USE_BREAKABLE_CUDAGRAPH=0

GPU_MEMORY_UTILIZATION=0.92
